# Copier en .env (non versionné) et compléter.

# Adresse publique du site : sitemap, canoniques, vérification après publication.
SITE_URL=https://www.drmattiacoda.fr

# Publication par SSH/rsync — informations fournies par l'hébergeur (cPanel).
DEPLOY_HOTE=
DEPLOY_UTILISATEUR=
DEPLOY_CHEMIN=/home/UTILISATEUR/public_html
DEPLOY_PORT=22

# Passer à false pour une préproduction : robots.txt bloque alors l'indexation.
SITE_INDEXABLE=true

# À activer UNIQUEMENT une fois le certificat en place et vérifié.
# Sans certificat, forcer HTTPS rend le site injoignable, et l'en-tête HSTS
# qui l'accompagne interdit tout repli sur HTTP pendant six mois.
SITE_HTTPS=false

# Administration locale (ne jamais exposer sur Internet).
ADMIN_PORT=4000
ADMIN_HOST=127.0.0.1
