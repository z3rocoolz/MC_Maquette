      "blocks": [
        {
          "type": "html",
          "html": "<div class=\"apropos-img\">\n      <img src=\"/assets/img/img-b65baa3ddbea.jpg\" alt=\"Dr Mattia Coda, chirurgien maxillo-facial, au bloc opératoire\" style=\"width:100%;height:100%;min-height:500px;object-fit:cover;object-position:center 20%;display:block;\">\n    </div>"
        },
        {
          "type": "group",
