    "id": "accueil",
    "raw": "<section class=\"hero\" id=\"accueil\">\n  <div class=\"hero-bg\"></div>\n  <div class=\"hero-content\">\n    <h1 class=\"hero-t2\">Rhinoplastie</h1>\n    <div class=\"hero-t1\">Chirurgie du Visage</div>\n    <div class=\"hero-btns\" style=\"margin-top:40px;\">\n      <a href=\"https://www.doctolib.fr\" target=\"_blank\" rel=\"noopener\" class=\"btn-or\">Prendre rendez-vous</a>\n    </div>\n    <div style=\"margin-top:24px;margin-bottom:24px;display:flex;flex-wrap:wrap;gap:10px;\">\n      <a href=\"/rhinoplastie/\" style=\"font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.15);padding:6px 12px;text-decoration:none;\">Rhinoplastie</a>\n      <a href=\"/lifting-cervico-facial/\" style=\"font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.15);padding:6px 12px;text-decoration:none;\">Lifting</a>\n      <a href=\"/blepharoplastie/\" style=\"font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.15);padding:6px 12px;text-decoration:none;\">Blépharoplastie</a>\n      <a href=\"/medecine-esthetique/\" style=\"font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.15);padding:6px 12px;text-decoration:none;\">Médecine Esthétique</a>\n      <a href=\"/dents-de-sagesse/\" style=\"font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.15);padding:6px 12px;text-decoration:none;\">Dents de Sagesse</a>\n    </div>\n    <div class=\"hero-villes\" style=\"margin-top:40px;\">\n      <span class=\"hero-ville\">Marseille</span>\n      <span class=\"hero-ville\">Nice</span>\n      <span class=\"hero-ville\">Draguignan</span>\n    </div>\n  </div>\n</section>",
